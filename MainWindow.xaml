                <Button x:Name="BtnRestorePoint" Style="{StaticResource Secondary}" Content="Crear punto de restauración" Padding="14,9" Margin="0,0,10,10"/>
                <Button x:Name="BtnRevertAll2" Style="{StaticResource Secondary}" Content="Restaurar todos los ajustes de Windows" Padding="14,9" Margin="0,0,10,10"/>
                <Button x:Name="BtnCheckUpdates" Style="{StaticResource Secondary}" Content="Buscar actualizaciones" Padding="14,9" Margin="0,0,10,10"/>
                <Button x:Name="BtnOpenData" Style="{StaticResource Secondary}" Content="Abrir carpeta de datos" Padding="14,9" Margin="0,0,10,10"/>
              </WrapPanel>
              <TextBlock Text="ACERCA DE" Style="{StaticResource Sec}"/>
              <Border Style="{StaticResource CardB}">
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentGrad}">
                      <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="AboutTitle" Text="GameBoost" FontSize="15" FontWeight="SemiBold"/>
                      <TextBlock Text="Desarrollado por BLAD Studios" Style="{StaticResource Cap}"/>
                    </StackPanel>
                  </StackPanel>
                  <TextBlock x:Name="AboutRight" Text="© 2026 BLAD Studios" Style="{StaticResource Cap}" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right"/>
                </Grid>
              </Border>
              <TextBlock Text="ACTIVIDAD" Style="{StaticResource Sec}"/>
              <TextBox x:Name="LogBox" IsReadOnly="True" Height="220" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#A8A8B0"/>
            </StackPanel>
          </ScrollViewer>

          <!-- ======== EDITOR OVERLAY ======== -->
          <Grid x:Name="Overlay" Visibility="Collapsed" Background="#CC07090D">
            <Border Width="540" Background="#161619" CornerRadius="14" BorderBrush="#2E2E34" BorderThickness="1" Padding="26,24" VerticalAlignment="Center" HorizontalAlignment="Center">
              <StackPanel>
                <TextBlock x:Name="EdTitle" Text="Editar juego" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Nombre" Style="{StaticResource Lbl}"/>
                <TextBox x:Name="EdName"/>
                <TextBlock Text="Ejecutable o URL de lanzamiento" Style="{StaticResource Lbl}"/>
                <Grid>
                  <TextBox x:Name="EdTarget" Margin="0,0,52,0"/>
                  <Button x:Name="EdBrowse" Style="{StaticResource Secondary}" Width="44" HorizontalAlignment="Right" Padding="0,8">
                    <TextBlock Text="&#xE8DA;" FontFamily="{StaticResource Icons}"/>
                  </Button>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Argumentos (opcional)" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="EdArgs"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Proceso del juego (sin .exe)" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="EdProc"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Prioridad de CPU" Style="{StaticResource Lbl}"/>
                <Border Background="#0F0F12" CornerRadius="9" Padding="3" HorizontalAlignment="Left" BorderBrush="{StaticResource Line}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="EdPrioN" Style="{StaticResource Seg}" Content="Normal" GroupName="prio"/>
                    <RadioButton x:Name="EdPrioA" Style="{StaticResource Seg}" Content="Superior" GroupName="prio"/>
                    <RadioButton x:Name="EdPrioH" Style="{StaticResource Seg}" Content="Alta (recomendado)" GroupName="prio"/>
                  </StackPanel>
                </Border>
                <Grid Margin="0,26,0,0">
                  <Button x:Name="EdDelete" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Foreground="#EF4444" Padding="10,8">
                    <TextBlock x:Name="EdDeleteText" Text="Eliminar juego"/>
                  </Button>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="EdCancel" Style="{StaticResource Secondary}" Content="Cancelar" Padding="16,9"/>
                    <Button x:Name="EdSave" Style="{StaticResource Primary}" Content="Guardar" Padding="20,9" Margin="10,0,0,0"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ======== TOAST ======== -->
          <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,22" Background="#1C1C20" CornerRadius="10" Padding="16,12" BorderBrush="#313137" BorderThickness="1" Opacity="0" IsHitTestVisible="False" MaxWidth="440">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="Black"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ToastIcon" FontFamily="{StaticResource Icons}" Text="&#xE73E;" Foreground="{StaticResource Ok}" VerticalAlignment="Top" Margin="0,2,12,0" FontSize="14"/>
              <TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="370"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
